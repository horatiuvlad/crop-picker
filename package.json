{
  "name": "@horatiuvlad/crop-picker",
  "version": "0.3.0",
  "description": "Cross-platform image crop picker for React Native AND React Native Web — one codebase: pan/pinch/rotate crop UI, pure-math core, pluggable extraction backends.",
  "license": "MIT",
  "author": "Horatiu Vlad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horatiuvlad/crop-picker.git"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "image",
    "crop",
    "cropper",
    "crop-picker",
    "pan",
    "pinch",
    "zoom",
    "reanimated",
    "gesture-handler"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "!**/__tests__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json",
    "prepack": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.14.0",
    "react-native-reanimated": ">=3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
